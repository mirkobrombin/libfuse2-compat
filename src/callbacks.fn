extern c fn bridgeGetAttribute(
    backendRequestValue *void,
    inode u64,
    info *void
) void as fuse2_foundation_bridge_getattr {
    const session = sessionFromBackendRequest(backendRequestValue)
    if isNull(session) return
    const legacy = convertFileInfo(info)
    var request = Request {
        Magic = 5058195789161252179
        Backend = backendRequestValue
        SessionValue = session
    }
    // SAFETY: all callback values remain live until the conversion is copied back.
    unsafe {
        const callback = (*(*session).Operations).GetAttribute
        callback(&request, inode, legacy)
    }
    copyFileInfoBack(legacy, info)
    releaseFileInfo(legacy)
}

