package libfuse2.compat

extern c fn bridgeInit(userData *void, connection *void) void as fuse2_foundation_bridge_init {
    if isNull(userData) || isNull(connection) return
    // SAFETY: FUSE3 passes the Session userdata and a live connection for this call.
    unsafe {
        const session = pointerCast<*Session>(userData)
        if !validSession(session) return
        const raw = allocateZeroed(1, 128)
        if isNull(raw) return
        const legacy = pointerCast<*LegacyConnectionPrefix>(raw)
        const backend = pointerCast<*BackendConnectionPrefix>(connection)
        discard replace (*legacy).ProtocolMajor with (*backend).ProtocolMajor
        discard replace (*legacy).ProtocolMinor with (*backend).ProtocolMinor
        discard replace (*legacy).AsyncRead with 1 if ((*backend).Capable & 1) != 0 else 0
        discard replace (*legacy).MaxWrite with (*backend).MaxWrite
        discard replace (*legacy).MaxReadAhead with (*backend).MaxReadAhead
        discard replace (*legacy).Capable with (*backend).Capable
        discard replace (*legacy).Want with (*backend).Want
        discard replace (*legacy).MaxBackground with (*backend).MaxBackground
        discard replace (*legacy).CongestionThreshold with (*backend).CongestionThreshold
        const callback = (*(*session).Operations).Init
        callback((*session).UserData, raw)
        var want = (*legacy).Want
        if (*legacy).AsyncRead != 0 {
            want = want | 1
        } else {
            const asyncRead u32 = 1
            want = want & ~asyncRead
        }
        discard replace (*backend).MaxWrite with (*legacy).MaxWrite
        discard replace (*backend).MaxReadAhead with (*legacy).MaxReadAhead
        discard replace (*backend).Want with want
        discard replace (*backend).MaxBackground with (*legacy).MaxBackground
        discard replace (*backend).CongestionThreshold with (*legacy).CongestionThreshold
        releaseMemory(raw)
    }
}

extern c fn bridgeDestroy(userData *void) void as fuse2_foundation_bridge_destroy {
    if isNull(userData) return
    // SAFETY: FUSE3 passes the Session userdata while the session remains live.
    unsafe {
        const session = pointerCast<*Session>(userData)
        if !validSession(session) return
        const callback = (*(*session).Operations).Destroy
        callback((*session).UserData)
    }
}

extern c fn bridgeLookup(
    backendRequestValue *void,
    parent u64,
    name *const i8
) void as fuse2_foundation_bridge_lookup {
    const session = sessionFromBackendRequest(backendRequestValue)
    if isNull(session) return
    var request = Request {
        Magic = 5058195789161252179
        Backend = backendRequestValue
        SessionValue = session
    }
    // SAFETY: the legacy callback and request wrapper remain live for this call.
    unsafe {
        const callback = (*(*session).Operations).Lookup
        callback(&request, parent, name)
    }
}

