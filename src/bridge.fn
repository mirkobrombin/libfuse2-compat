        const result = call(args, argument)
        closeApi(api)
        return result
    }
}

extern c fn FuseOptFreeArgs(args *void) void as fuse_opt_free_args {
    const api = openApi()
    if isNull(api) return
    // SAFETY: the loaded symbol has the FUSE3 option-free signature.
    unsafe {
        const call = pointerCast<extern c fn(*void) void>((*api).OptFreeArgs)
        call(args)
        closeApi(api)
    }
}

extern c fn FuseParseCommandLine(
    args *void,
    mountpoint **i8,
    multithreaded *i32,
    foreground *i32
) i32 as fuse_parse_cmdline {
    const api = openApi()
    if isNull(api) return -1
    // SAFETY: outputs and the allocated FUSE3 option record are live for this call.
    unsafe {
        const raw = allocateZeroed(1, sizeOf<BackendCommandLine>())
        if isNull(raw) {
            closeApi(api)
            return -1
        }
        const options = pointerCast<*BackendCommandLine>(raw)
        const call = pointerCast<extern c fn(*void, *BackendCommandLine) i32>(
            (*api).ParseCommandLine
        )
        const result = call(args, options)
        if result != 0 {
            releaseMemory(options)
            closeApi(api)
            return -1
        }
        if !isNull(multithreaded) {
            *multithreaded = 1 if (*options).SingleThread == 0 else 0
        }
        if !isNull(foreground) {
            *foreground = (*options).Foreground
        }
        if !isNull(mountpoint) {
            *mountpoint = (*options).Mountpoint
        } else {
            if !isNull((*options).Mountpoint) {
                releaseMemory((*options).Mountpoint)
            }
        }
        releaseMemory(options)
        closeApi(api)
        return 0
    }
}

extern c fn FuseDaemonize(foreground i32) i32 as fuse_daemonize {
    const api = openApi()
    if isNull(api) return -1
    // SAFETY: the loaded symbol has the FUSE3 daemonize signature.
    unsafe {
        const call = pointerCast<extern c fn(i32) i32>((*api).Daemonize)
        const result = call(foreground)
        closeApi(api)
        return result
    }
}

extern c fn FuseVersion() i32 as fuse_version {
    29
}

extern c fn FuseMount(mountpoint *const i8, args *void) *void as fuse_mount {
    discard args
    if isNull(mountpoint) {
        setErrno(22)
        return emptyPointer()
    }
    const api = openApi()
    if isNull(api) {
        setErrno(38)
        return emptyPointer()
    }
    closeApi(api)
    // SAFETY: mountpoint is NUL-terminated and channel storage is calloc-owned.
    unsafe {
        const raw = allocateZeroed(1, sizeOf<CompatChannel>())
        if isNull(raw) return null<*void>()
        const channel = pointerCast<*CompatChannel>(raw)
        const copy = duplicateString(mountpoint)
        if isNull(copy) {
            releaseMemory(channel)
            return null<*void>()
        }
        discard replace (*channel).Magic with 5058179287744597580
        discard replace (*channel).Mountpoint with copy
        return channel
    }
}

extern c fn FuseLowLevelNew(
    args *void,
    operations *const void,
    operationSize usize,
    userData *void
) *void as fuse_lowlevel_new {
    if isNull(args) || isNull(operations) {
        setErrno(22)
        return emptyPointer()
    }
    const api = openApi()
    if isNull(api) {
        setErrno(38)
        return emptyPointer()
    }
    const legacy = copyLegacyOperations(operations, operationSize)
    if isNull(legacy) {
        closeApi(api)
        return emptyPointer()
    }
    const backendOperations = configureBackendOperations(legacy)
    if isNull(backendOperations) {
        // SAFETY: legacy was allocated by copyLegacyOperations.
        unsafe {
            releaseMemory(legacy)
        }
        closeApi(api)
        return emptyPointer()
    }
    // SAFETY: all allocated records use their checked C layouts.
    unsafe {
        const raw = allocateZeroed(1, sizeOf<Session>())
        if isNull(raw) {
            releaseMemory(backendOperations)
            releaseMemory(legacy)
            closeApi(api)
            return null<*void>()
        }
        const session = pointerCast<*Session>(raw)
        discard replace (*session).Magic with 5058179356414923598
        discard replace (*session).ApiTable with api
        discard replace (*session).Operations with legacy
        discard replace (*session).UserData with userData
        const create = pointerCast<extern c fn(
            *void,
            *const void,
            usize,
            *void
        ) *void>((*api).SessionNew)
        const backend = create(args, backendOperations, sizeOf<BackendOps>(), session)
        releaseMemory(backendOperations)
        if isNull(backend) {
            discard replace (*session).Magic with 0
            releaseMemory(legacy)
            releaseMemory(session)
            closeApi(api)
            return null<*void>()
        }
        discard replace (*session).Backend with backend
        return session
    }
}

fn removeChannel(channel *CompatChannel) void {
    if !validChannel(channel) return
    // SAFETY: a mounted channel holds a live session and API table.
    unsafe {
        const session = pointerCast<*Session>((*channel).SessionValue)
        if (*channel).Mounted && validSession(session) {
            const api = (*session).ApiTable
            const unmount = pointerCast<extern c fn(*void) void>((*api).SessionUnmount)
            unmount((*session).Backend)
            discard replace (*channel).Mounted with false
        }
        if validSession(session) && (*session).ChannelValue == channel {
            discard replace (*session).ChannelValue with null<*void>()
        }
        discard replace (*channel).SessionValue with null<*void>()
    }
}

extern c fn FuseSessionAddChannel(
    sessionValue *void,
    channelValue *void
) void as fuse_session_add_chan {
    if isNull(sessionValue) || isNull(channelValue) return
    // SAFETY: both opaque handles originate from this compatibility library.
    unsafe {
        const session = pointerCast<*Session>(sessionValue)
        const channel = pointerCast<*CompatChannel>(channelValue)
        if !validSession(session) || !validChannel(channel) return
        const api = (*session).ApiTable
        const mount = pointerCast<extern c fn(*void, *const i8) i32>(
            (*api).SessionMount
        )
        if mount((*session).Backend, (*channel).Mountpoint) != 0 {
            const current = readErrno()
            discard replace (*session).MountError with current if current != 0 else 5
            return
        }
        discard replace (*channel).Mounted with true
        discard replace (*channel).SessionValue with session
        discard replace (*session).ChannelValue with channel
    }
}

extern c fn FuseSessionRemoveChannel(channelValue *void) void as fuse_session_remove_chan {
    if isNull(channelValue) return
    // SAFETY: the opaque channel originates from this compatibility library.
    unsafe {
        removeChannel(pointerCast<*CompatChannel>(channelValue))
    }
}

extern c fn FuseSessionLoop(sessionValue *void) i32 as fuse_session_loop {
    if isNull(sessionValue) return -1
    // SAFETY: the opaque session originates from this compatibility library.
    unsafe {
        const session = pointerCast<*Session>(sessionValue)
        if !validSession(session) return -1
        if (*session).MountError != 0 return -(*session).MountError
        const api = (*session).ApiTable
        const loop = pointerCast<extern c fn(*void) i32>((*api).SessionLoop)
        return loop((*session).Backend)
    }
}

extern c fn FuseSessionDestroy(sessionValue *void) void as fuse_session_destroy {
    if isNull(sessionValue) return
    // SAFETY: the opaque session is consumed exactly once by this call.
    unsafe {
        const session = pointerCast<*Session>(sessionValue)
        if !validSession(session) return
        const channelValue = (*session).ChannelValue
        const channel = pointerCast<*CompatChannel>(channelValue)
        if !isNull(channelValue) && (*channel).Mounted {
            removeChannel(channel)
        }
        if !isNull(channelValue) {
            discard replace (*channel).SessionValue with null<*void>()
        }
        const api = (*session).ApiTable
        const destroy = pointerCast<extern c fn(*void) void>((*api).SessionDestroy)
        destroy((*session).Backend)
        discard replace (*session).Backend with null<*void>()
        discard replace (*session).Magic with 0
        releaseMemory((*session).Operations)
        closeApi(api)
        releaseMemory(session)
    }
}

extern c fn FuseUnmount(
    mountpoint *const i8,
    channelValue *void
) void as fuse_unmount {
    discard mountpoint
    if isNull(channelValue) return
    // SAFETY: the opaque channel is consumed exactly once by this call.
    unsafe {
        const channel = pointerCast<*CompatChannel>(channelValue)
        if !validChannel(channel) return
        if (*channel).Mounted || !isNull((*channel).SessionValue) {
            removeChannel(channel)
        }
        discard replace (*channel).Magic with 0
        releaseMemory((*channel).Mountpoint)
        releaseMemory(channel)
    }
}

