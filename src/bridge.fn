extern c fn FuseReplyOpen(
    request *void,
    info *const void
) i32 as fuse_reply_open {
    const session = requestSession(request)
    const backend = backendRequest(request)
    if isNull(session) || isNull(backend) || isNull(info) return -38
    const converted = convertLegacyFileInfo(info)
    if isNull(converted) return -38
    // SAFETY: converted has the FUSE3 file-info layout for this call.
    unsafe {
        const api = (*session).ApiTable
        const call = pointerCast<extern c fn(*void, *const BackendFileInfo) i32>(
            (*api).ReplyOpen
        )
        const result = call(backend, converted)
        releaseBackendFileInfo(converted)
        return result
    }
}

