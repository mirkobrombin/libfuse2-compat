extern c fn foundationBridgeInit(
    callback extern c fn(*void, *void) void,
    userData *void,
    connection *void
) void as fuse2_foundation_bridge_init {
    // SAFETY: callback and FUSE2 values are live for this call.
    unsafe {
        callback(userData, connection)
    }
}

extern c fn foundationBridgeDestroy(
    callback extern c fn(*void) void,
    userData *void
) void as fuse2_foundation_bridge_destroy {
    // SAFETY: callback and userdata are live for this call.
    unsafe {
        callback(userData)
    }
}

extern c fn foundationBridgeLookup(
    callback extern c fn(*void, u64, *const i8) void,
    request *void,
    parent u64,
    name *const i8
) void as fuse2_foundation_bridge_lookup {
    // SAFETY: callback and request values are live for this call.
    unsafe {
        callback(request, parent, name)
    }
}

