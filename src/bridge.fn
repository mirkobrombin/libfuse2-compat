    callback extern c fn(*void, u64, *const i8, u32, *void) void,
    request *void,
    parent u64,
    name *const i8,
    mode u32,
    info *void
) void as fuse2_foundation_bridge_create {
    // SAFETY: callback, name, and info are live for this call.
    unsafe {
        callback(request, parent, name, mode, info)
    }
}

extern c fn FuseOptParse(
    args *void,
    data *void,
    options *const void,
    process extern c fn(*void, *const i8, i32, *void) i32
) i32 as fuse_opt_parse {
    // SAFETY: libfuse2 owns each pointer for this call.
    unsafe {
        return nativeOptParse(args, data, options, process)
    }
}

extern c fn FuseOptAddArg(
    args *void,
    argument *const i8
) i32 as fuse_opt_add_arg {
    // SAFETY: the argument vector and string are live for this call.
    unsafe {
        return nativeOptAddArg(args, argument)
    }
}

extern c fn FuseOptFreeArgs(args *void) void as fuse_opt_free_args {
    // SAFETY: libfuse2 owns the argument vector released here.
    unsafe {
        nativeOptFreeArgs(args)
    }
}

extern c fn FuseParseCommandLine(
    args *void,
    mountpoint **i8,
    multithreaded *i32,
    foreground *i32
) i32 as fuse_parse_cmdline {
    // SAFETY: outputs follow the call-scoped FUSE2 contract.
    unsafe {
        return nativeParseCommandLine(
            args,
            mountpoint,
            multithreaded,
            foreground
        )
    }
}

extern c fn FuseDaemonize(foreground i32) i32 as fuse_daemonize {
    nativeDaemonize(foreground)
}

extern c fn FuseVersion() i32 as fuse_version {
    29
}

extern c fn FuseMount(mountpoint *const i8, args *void) *void as fuse_mount {
    // SAFETY: the mountpoint is NUL-terminated and args follows the FUSE2 ABI.
    unsafe {
        return nativeMount(mountpoint, args)
    }
}

extern c fn FuseLowLevelNew(
    args *void,
    operations *const void,
    operationSize usize,
    userData *void
) *void as fuse_lowlevel_new {
    // SAFETY: operations has operationSize readable bytes.
    unsafe {
        return nativeLowLevelNew(args, operations, operationSize, userData)
    }
}

extern c fn FuseSessionAddChannel(
    session *void,
    channel *void
) void as fuse_session_add_chan {
    // SAFETY: both opaque handles originate from this compatibility library.
    unsafe {
        nativeSessionAddChannel(session, channel)
    }
}

extern c fn FuseSessionRemoveChannel(
    channel *void
) void as fuse_session_remove_chan {
    // SAFETY: the opaque channel originates from this compatibility library.
    unsafe {
        nativeSessionRemoveChannel(channel)
    }
}

extern c fn FuseSessionLoop(session *void) i32 as fuse_session_loop {
    // SAFETY: the opaque session originates from this compatibility library.
    unsafe {
        return nativeSessionLoop(session)
    }
}

extern c fn FuseSessionDestroy(session *void) void as fuse_session_destroy {
    // SAFETY: the opaque session is consumed by the historical destroy call.
    unsafe {
        nativeSessionDestroy(session)
    }
}

extern c fn FuseUnmount(
    mountpoint *const i8,
    channel *void
) void as fuse_unmount {
    // SAFETY: channel and mountpoint are live for this call.
    unsafe {
        nativeUnmount(mountpoint, channel)
    }
}

extern c fn FuseSetSignalHandlers(
    session *void
) i32 as fuse_set_signal_handlers {
    // SAFETY: the opaque session originates from this compatibility library.
    unsafe {
        return nativeSetSignalHandlers(session)
    }
}

extern c fn FuseRemoveSignalHandlers(
    session *void
) void as fuse_remove_signal_handlers {
    // SAFETY: the opaque session originates from this compatibility library.
    unsafe {
        nativeRemoveSignalHandlers(session)
    }
}

extern c fn FuseSessionExit(session *void) void as fuse_session_exit {
    // SAFETY: the opaque session remains live during the exit request.
    unsafe {
        nativeSessionExit(session)
    }
}

extern c fn FuseSessionExited(session *void) i32 as fuse_session_exited {
    // SAFETY: the opaque session remains live during this state query.
    unsafe {
        return nativeSessionExited(session)
    }
}

extern c fn FuseSessionReset(session *void) void as fuse_session_reset {
    // SAFETY: the opaque session remains live during the reset request.
    unsafe {
        nativeSessionReset(session)
    }
}

extern c fn FuseRequestUserData(request *void) *void as fuse_req_userdata {
    // SAFETY: the opaque request remains live for the duration of its callback.
    unsafe {
        return nativeRequestUserData(request)
    }
}

extern c fn FuseReplyError(request *void, errorCode i32) i32 as fuse_reply_err {
    // SAFETY: the opaque request remains live until the reply completes.
    unsafe {
        return nativeReplyError(request, errorCode)
    }
}

extern c fn FuseReplyNone(request *void) void as fuse_reply_none {
    // SAFETY: the opaque request remains live until the reply completes.
    unsafe {
        nativeReplyNone(request)
    }
}

extern c fn FuseReplyEntry(
    request *void,
    entry *const void
) i32 as fuse_reply_entry {
    // SAFETY: entry is a live FUSE2 entry for this call.
    unsafe {
        return nativeReplyEntry(request, entry)
    }
}

extern c fn FuseReplyAttribute(
    request *void,
    statValue *const void,
    expiration f64
) i32 as fuse_reply_attr {
    // SAFETY: statValue is a live stat value for this call.
    unsafe {
        return nativeReplyAttribute(request, statValue, expiration)
    }
}

extern c fn FuseReplyOpen(
    request *void,
    info *const void
) i32 as fuse_reply_open {
    // SAFETY: info is a live FUSE2 file-info value for this call.
    unsafe {
        return nativeReplyOpen(request, info)
    }
}

extern c fn FuseReplyBuffer(
    request *void,
    buffer *const i8,
    size usize
) i32 as fuse_reply_buf {
    // SAFETY: buffer has size live bytes for this call.
    unsafe {
        return nativeReplyBuffer(request, buffer, size)
    }
}

extern c fn FuseReplyReadLink(
    request *void,
    target *const i8
) i32 as fuse_reply_readlink {
    // SAFETY: target is NUL-terminated and live for this call.
    unsafe {
        return nativeReplyReadLink(request, target)
    }
}

extern c fn FuseReplyExtendedAttribute(
    request *void,
    count usize
) i32 as fuse_reply_xattr {
    // SAFETY: the opaque request remains live until the reply completes.
    unsafe {
        return nativeReplyExtendedAttribute(request, count)
    }
}

extern c fn FuseReplyWrite(request *void, count usize) i32 as fuse_reply_write {
    // SAFETY: the opaque request remains live until the reply completes.
    unsafe {
        return nativeReplyWrite(request, count)
    }
}

extern c fn FuseReplyFileSystem(
    request *void,
    value *const void
) i32 as fuse_reply_statfs {
    // SAFETY: value is a live statvfs value for this call.
    unsafe {
        return nativeReplyFileSystem(request, value)
    }
}

extern c fn FuseReplyCreate(
    request *void,
    entry *const void,
    info *const void
) i32 as fuse_reply_create {
    // SAFETY: both FUSE2 values are live for this call.
    unsafe {
        return nativeReplyCreate(request, entry, info)
    }
}

extern c fn FuseReplyLock(
    request *void,
    lock *const void
) i32 as fuse_reply_lock {
    // SAFETY: lock points to a live flock structure for this synchronous reply.
    unsafe {
        return nativeReplyLock(request, lock)
    }
}

extern c fn FuseReplyBlockMap(request *void, index u64) i32 as fuse_reply_bmap {
    // SAFETY: the opaque request remains live until the reply completes.
    unsafe {
        return nativeReplyBlockMap(request, index)
    }
}

extern c fn FuseAddDirectoryEntry(
    request *void,
    buffer *i8,
    bufferSize usize,
    name *const i8,
    status *const void,
    offset isize
) usize as fuse_add_direntry {
    // SAFETY: buffers and status follow the call-scoped FUSE2 contract.
    unsafe {
        return nativeAddDirectoryEntry(
            request,
            buffer,
            bufferSize,
            name,
            status,
            offset
        )
    }
}
