extern c fn FuseRequestUserData(request *void) *void as fuse_req_userdata {
    const session = requestSession(request)
    if isNull(session) return emptyPointer()
    // SAFETY: requestSession validated the live session.
    unsafe {
        return (*session).UserData
    }
}

extern c fn FuseReplyError(request *void, errorCode i32) i32 as fuse_reply_err {
    const session = requestSession(request)
    const backend = backendRequest(request)
    if isNull(session) || isNull(backend) return -38
    // SAFETY: the request wrapper owns a live backend request and API table.
    unsafe {
        const api = (*session).ApiTable
        const call = pointerCast<extern c fn(*void, i32) i32>((*api).ReplyError)
        return call(backend, errorCode)
    }
}

