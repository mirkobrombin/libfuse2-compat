package libfuse2.compat

extern c fn FuseOptParse(
    args *void,
    data *void,
    options *const void,
    process extern c fn(*void, *const i8, i32, *void) i32
) i32 as fuse_opt_parse {
    const api = openApi()
    if isNull(api) return -1
    // SAFETY: the loaded symbol and legacy arguments share the FUSE option ABI.
    unsafe {
        const call = pointerCast<extern c fn(
            *void,
            *void,
            *const void,
            extern c fn(*void, *const i8, i32, *void) i32
        ) i32>((*api).OptParse)
        const result = call(args, data, options, process)
        closeApi(api)
        return result
    }
}

