extern c fn FuseAddDirectoryEntry(
    request *void,
    buffer *i8,
    bufferSize usize,
    name *const i8,
    status *const void,
    offset isize
) usize as fuse_add_direntry {
    const session = requestSession(request)
    const backend = backendRequest(request)
    if isNull(session) || isNull(backend) return 0
    // SAFETY: buffers and status remain live for this synchronous call.
    unsafe {
        const api = (*session).ApiTable
        const call = pointerCast<extern c fn(
            *void,
            *i8,
            usize,
            *const i8,
            *const void,
            isize
        ) usize>((*api).AddDirectoryEntry)
        return call(backend, buffer, bufferSize, name, status, offset)
    }
}
