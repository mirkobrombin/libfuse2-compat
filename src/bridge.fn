extern c fn FuseReplyCreate(
    request *void,
    entry *const void,
    info *const void
) i32 as fuse_reply_create {
    const session = requestSession(request)
    const backend = backendRequest(request)
    if isNull(session) || isNull(backend) || isNull(entry) || isNull(info) return -38
    const converted = convertLegacyFileInfo(info)
    if isNull(converted) return -38
    // SAFETY: entry and converted info have the FUSE3 reply layouts for this call.
    unsafe {
        const api = (*session).ApiTable
        const call = pointerCast<extern c fn(
            *void,
            *const void,
            *const BackendFileInfo
        ) i32>((*api).ReplyCreate)
        const result = call(backend, entry, converted)
        releaseBackendFileInfo(converted)
        return result
    }
}

